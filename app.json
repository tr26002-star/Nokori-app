{
  "expo": {
    "name": "Nokori-app",
    "slug": "Nokori-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo/icon.png",
    "scheme": "nokoriapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.nokory.app",
      "adaptiveIcon": {
        "backgroundColor": "#4E2778",
        "foregroundImage": "./logo/adaptive-icon-foreground.png",
        "monochromeImage": "./logo/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E2778",
          "image": "./logo/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nokory necesita acceso a tus fotos para adjuntar una imagen al producto.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
