{
  "expo": {
    "name": "NOKORY",
    "slug": "Nokori-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo/icon.png",
    "scheme": "nokoriapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.nokory.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4E2778",
        "foregroundImage": "./logo/adaptive-icon-foreground.png",
        "monochromeImage": "./logo/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E2778",
          "image": "./logo/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nokory necesita acceso a tus fotos para añadir una foto de perfil o de producto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nokory utiliza tu ubicación para mostrar negocios y packs cercanos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d00653af-0db2-495d-bfb2-27b37bf23d21"
      }
    }
  }
}
