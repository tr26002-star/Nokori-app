EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
# Backend Node: usa IPv4 local solo para Expo Go en la misma Wi-Fi; usa la URL
# pública HTTPS de Render para Expo Go fuera de casa o para generar la APK.
EXPO_PUBLIC_BACKEND_URL=

# Servidor local con Gmail SMTP. Nunca agregues el prefijo EXPO_PUBLIC_.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL=

# Para alojar la API en Render Free, usa Resend por HTTPS (Render Free bloquea SMTP).
RESEND_API_KEY=
# Sin dominio propio, usa el remitente de prueba y registra la cuenta de Resend
# con el mismo correo que recibe soporte. Para producción con dominio, verifícalo en Resend.
RESEND_FROM_EMAIL=
